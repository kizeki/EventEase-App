@page "/events/{EventId:int}"
@inject EventDataService EventData

<PageTitle>@(eventItem?.Name ?? "Event") | EventEase</PageTitle>

@if (isLoading)
{
    <div class="loading-state">Finding this event...</div>
}
else if (eventItem is null)
{
    <NotFound />
}
else
{
    <a class="back-link" href="/">← Back to all events</a>
    <article class="event-detail">
        <div class="detail-image-wrap">
            <img src="@eventItem.ImageUrl" alt="" />
            <span class="detail-date">@eventItem.Date.ToString("dddd, MMMM d, yyyy")</span>
        </div>
        <div class="detail-content">
            <p class="eyebrow">EVENT @eventItem.Id.ToString("00")</p>
            <h1>@eventItem.Name</h1>
            <p class="detail-location">◎ @eventItem.Location</p>
            <p class="detail-description">@eventItem.Description</p>
            <div class="attendee-section">
                <div>
                    <p class="section-label">Going</p>
                    <p class="attendee-count">@attendees.Count attendees</p>
                </div>
                <div class="avatar-stack" aria-label="Event attendees">
                    @foreach (var attendee in attendees.Take(6))
                    {
                        <img src="@attendee.AvatarUrl" alt="@attendee.Name" title="@attendee.Name" />
                    }
                </div>
            </div>
            @if (isAttending)
            {
                <div class="registration-success" role="status">
                    <span aria-hidden="true">✓</span>
                    You're on the list. See you there!
                </div>
            }
            else
            {
                <section class="registration-panel" aria-labelledby="registration-heading">
                    <p class="section-label">Join this event</p>
                    <h2 id="registration-heading">Save your spot.</h2>
                    <EditForm Model="registration" OnValidSubmit="RegisterAttendee">
                        <DataAnnotationsValidator />
                        <div class="registration-fields">
                            <label>
                                <span>Name</span>
                                <InputText @bind-Value="registration.Name" autocomplete="name" placeholder="Your name" />
                                <ValidationMessage For="@(() => registration.Name)" />
                            </label>
                            <label>
                                <span>Email</span>
                                <InputText @bind-Value="registration.Email" autocomplete="email" placeholder="you@example.com" type="email" />
                                <ValidationMessage For="@(() => registration.Email)" />
                            </label>
                        </div>
                        <button class="primary-action" type="submit">
                            Register for this event <span aria-hidden="true">↗</span>
                        </button>
                    </EditForm>
                </section>
            }
        </div>
    </article>
}

@code {
    [Parameter]
    public int EventId { get; set; }

    private Event? eventItem;
    private List<User> attendees = [];
    private bool isAttending;
    private bool isLoading = true;
    private RegistrationModel registration = new();

    protected override async Task OnParametersSetAsync()
    {
        var events = await EventData.GetEventsAsync();
        var users = await EventData.GetUsersAsync();
        eventItem = events.FirstOrDefault(item => item.Id == EventId);
        attendees = eventItem is null
            ? []
            : users.Where(user => eventItem.Attendees.Contains(user.Id)).ToList();
        isLoading = false;
    }

    private void RegisterAttendee()
    {
        if (eventItem is null)
        {
            return;
        }

        var nextId = attendees.Count == 0 ? 1 : attendees.Max(attendee => attendee.Id) + 1;
        var attendee = new User
        {
            Id = nextId,
            Name = registration.Name.Trim(),
            Email = registration.Email.Trim(),
            AvatarUrl = $"https://picsum.photos/seed/{Uri.EscapeDataString(registration.Name.Trim())}/96/96"
        };

        attendees.Add(attendee);
        eventItem.Attendees.Add(attendee.Id);
        isAttending = !isAttending;
    }

    private sealed class RegistrationModel
    {
        [Required(ErrorMessage = "Please enter your name.")]
        [StringLength(80, MinimumLength = 2, ErrorMessage = "Name must be between 2 and 80 characters.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
