@page "/"
@inject EventDataService EventData
@inject RegistrationStateService RegistrationState

<PageTitle>Discover events | EventEase</PageTitle>

<section class="events-hero">
	<div>
		<p class="eyebrow">MAKE ROOM FOR SOMETHING GOOD</p>
		<h1>Find your next <em>favorite</em> gathering.</h1>
		<p class="hero-copy">A considered list of talks, dinners, walks, and nights worth leaving the house for.</p>
	</div>
	<div class="hero-note">
		<span class="hero-note-mark">✦</span>
		<span>Curated for curious people<br />in every kind of city.</span>
	</div>
</section>

<section class="events-toolbar" aria-label="Event filters">
	<div class="search-field">
		<span aria-hidden="true">⌕</span>
		<input @bind="searchTerm" @bind:event="oninput" @bind:after="LoadFirstPageAsync" placeholder="Search events, places, ideas..." aria-label="Search events" />
	</div>
	<label class="filter-field">
		<span>Date</span>
		<select @bind="dateFilter" @bind:after="LoadFirstPageAsync" aria-label="Filter by date">
			<option value="all">All dates</option>
			<option value="this-month">This month</option>
			<option value="next-month">Next month</option>
		</select>
	</label>
	<label class="filter-field">
		<span>Location</span>
		<select @bind="locationFilter" @bind:after="LoadFirstPageAsync" aria-label="Filter by location">
			<option value="all">All locations</option>
			@foreach (var location in locations)
			{
				<option value="@location">@location</option>
			}
		</select>
	</label>
	<label class="filter-field">
		<span>View</span>
		<select @bind="viewFilter" @bind:after="LoadFirstPageAsync" aria-label="Filter by registration status">
			<option value="all">All events</option>
			<option value="registered">My events</option>
		</select>
	</label>
</section>

@if (events is null)
{
	<div class="loading-state">Gathering the good stuff...</div>
}
else if (events.Count == 0)
{
	<div class="empty-state">
		<span class="empty-icon">◌</span>
		<h2>No events found</h2>
		<p>Try another search or clear one of the filters.</p>
	</div>
}
else
{
	<div class="results-heading">
		<p><strong>@totalEventCount.ToString("00")</strong> events to explore</p>
		<span>Sorted by date</span>
	</div>
	<div class="event-grid">
		@foreach (var eventItem in events)
		{
			<EventCard EventItem="eventItem"
					   AttendeeCount="@GetAttendeeCount(eventItem)"
					   IsRegistered="@registeredEventIds.Contains(eventItem.Id)" />
		}
	</div>
	@if (hasMoreEvents)
	{
		<div class="load-more-wrap">
			<button class="load-more-button" type="button" @onclick="LoadMoreAsync">
				Load more <span>@(totalEventCount - events.Count) remaining</span>
			</button>
		</div>
	}
}

@code {
	private List<Event>? events;
	private IReadOnlyList<string> locations = [];
	private int totalEventCount;
	private bool hasMoreEvents;
	private string searchTerm = string.Empty;
	private string dateFilter = "all";
	private string locationFilter = "all";
	private string viewFilter = "all";
	private HashSet<int> registeredEventIds = [];
	private const int PageSize = 12;
	private int currentPage;

	protected override async Task OnInitializedAsync()
	{
		await RegistrationState.LoadAsync();
		registeredEventIds = RegistrationState.State.RegisteredEventIds;
		locations = await EventData.GetLocationsAsync();
		await LoadFirstPageAsync();
	}

	private int GetAttendeeCount(Event eventItem)
	{
		var localUser = RegistrationState.State.User;
		var localUserAlreadyIncluded = localUser is not null && eventItem.Attendees.Contains(localUser.Id);
		return eventItem.Attendees.Count + (registeredEventIds.Contains(eventItem.Id) && !localUserAlreadyIncluded ? 1 : 0);
	}

	private async Task LoadFirstPageAsync()
	{
		currentPage = 1;
		await LoadPageAsync(false);
	}

	private async Task LoadMoreAsync()
	{
		if (!hasMoreEvents)
		{
			return;
		}

		currentPage++;
		await LoadPageAsync(true);
	}

	private async Task LoadPageAsync(bool append)
	{
		var page = await EventData.GetEventsPageAsync(
			currentPage,
			PageSize,
			searchTerm,
			dateFilter,
			locationFilter,
			viewFilter,
			registeredEventIds);
		totalEventCount = page.TotalCount;
		hasMoreEvents = page.HasMore;
		if (append)
		{
			events!.AddRange(page.Items);
		}
		else
		{
			events = page.Items.ToList();
		}
	}
}
