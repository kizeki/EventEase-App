@page "/not-found"
@layout MainLayout

<PageTitle>Page not found | EventEase</PageTitle>

<section class="not-found-page">
	<div class="not-found-icon" aria-hidden="true">↗</div>
	<p class="eyebrow">ERROR 404</p>
	<h1>That page took<br /><em>a wrong turn.</em></h1>
	<p class="not-found-copy">The event or page you are looking for does not exist, or it may have moved.</p>
	<a class="not-found-action" href="/">Back to all events <span aria-hidden="true">→</span></a>
</section>